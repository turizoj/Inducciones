DATABASE_URL="mysql://usuario:clave@localhost:3306/sigein_db"
JWT_SECRET="cambiar_por_una_clave_larga_y_secreta"
JWT_EXPIRES_IN="8h"
PORT=4000
FRONTEND_URL="http://localhost:5173"
# Nombre de la empresa que usa SIGEIN (aparece en certificados y reportes). Vacío = "SIGEIN".
EMPRESA_NOMBRE=""

# Correo (opcional). Si SMTP_HOST queda vacío, los correos se muestran en la consola del backend.
# Con Gmail: active la verificación en dos pasos y cree una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords; úsela en SMTP_PASS (no use su contraseña normal).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
CORREO_REMITENTE=""
